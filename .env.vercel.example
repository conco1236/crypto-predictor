# Copy these keys into Vercel Project Settings → Environment Variables. Never commit real values.
DEPLOY_TARGET=vercel
VITE_DEPLOY_TARGET=vercel
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Random server-only value, 16+ characters. Vercel includes it as Authorization: Bearer <value> for Cron.
CRON_SECRET=
# Random server-only value used once to register the Telegram webhook after production deploy.
ADMIN_SETUP_TOKEN=
